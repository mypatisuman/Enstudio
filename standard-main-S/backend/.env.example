# EngineeringStudio — environment template.
#
# Copy to `studio/.env` and fill in real values. `.env` is gitignored; THIS
# file is committed, so it must never contain a real credential.
#
#   cp studio/.env.example studio/.env
#
# NOTE ON LLM PROVIDER KEYS
# -------------------------
# Provider API keys are NOT read from the environment. They are set in the
# app's Settings screen and stored encrypted (Windows DPAPI) in the
# `settings` table of studio.db — see studio/adapters/config.py and
# studio/adapters/secrets.py. There is deliberately no env-var fallback, so
# a key pasted here would be ignored. Do not add one.


# ── Hub location ─────────────────────────────────────────────────────────────
# Where projects, exports and studio.db live.
# Defaults to <repo>/EngineeringHub/EngineeringHub when unset.
ENGINEERING_HUB=


# ── Auth (Flask API) ─────────────────────────────────────────────────────────
# REQUIRED. Signing secret for API tokens. Generate a fresh one per install:
#   openssl rand -hex 32
# Without it the server boots on a well-known dev secret and warns loudly —
# anyone could then forge a valid token.
JWT_SECRET=
JWT_EXPIRE_HOURS=24

# Development escape hatch ONLY. When set to 1, the /api surface accepts
# unauthenticated requests so the legacy Flask HTML UI (which has no login
# screen) can be worked on locally. Never set this on a machine that is
# reachable by anything you do not control.
# STUDIO_ALLOW_ANONYMOUS=0


# ── SMTP (password-reset OTP email) ──────────────────────────────────────────
# For Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and use that 16-character value
# as SMTP_PASSWORD — never the account login password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=


# ── DeepInfra LLM Provider (Environment Fallback) ────────────────────────────
# DeepInfra credentials and endpoints can be configured in the Settings UI or
# provided via environment variables:
DEEPINFRA_API_KEY=
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
DEEPINFRA_MODEL_SMART=google/gemma-4-31B-it-turbo
DEEPINFRA_MODEL_FAST=google/gemma-4-31B-it-turbo
