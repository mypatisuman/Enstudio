# mongo.env.example — template for the repo-root mongo.env.
#
# mongo.env is gitignored (see .gitignore). THIS file is committed, so it
# must never contain a real credential. Copy it and fill in values:
#
#     cp mongo.env.example mongo.env
#
# Every key name below was present in the pre-rotation mongo.env. ALL
# values are blanked — including those on commented-out lines, which in
# the original still held live credentials.

AzureWebJobsStorage=""
FUNCTIONS_WORKER_RUNTIME=""
FUNCTIONS_WORKER_RUNTIME_VERSION=""
SECRET_KEY=""
JWT_SECRET_KEY=""
AZURE_ENV=""
PORT=""
# Production Azure MySQL Database (blocked by local firewall/IP restrictions in local dev environment)
# DATABASE_URL=""

# Local SQLite Database for Development
MONGODB_URI=""
MONGODB_DATABASE=""
# Cluster B — holds the enriched Restructured hierarchy (L0/L1/L2 with certifications).
# get_restructured_db() uses this client; all other DB calls still go to Cluster A.
RESTRUCTURED_DB_URI=""
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_STORAGE_ACCOUNT_NAME=""
AZURE_STORAGE_ACCOUNT_KEY=""
# GOOGLE_API_KEY=""
# GOOGLE_API_KEY1=""
# GOOGLE_CSE_ID=""
# GEMMA-ONLY MODE: Azure OpenAI connection disabled (uncomment to restore).
# OPEN_API_KEY=""
# OPEN_API_KEY1=""
# AZURE_OPENAI_ENDPOINT=""
# ANTHROPIC_API_KEY=""
HUGGINGFACE_API_KEY=""
# AZURE_KIMI_ENDPOINT=""
# AZURE_KIMI_API_KEY=""
