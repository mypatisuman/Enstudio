# Set to true to disable PyMuPDF (fitz) and use pypdf fallback (prevents segmentation faults in production / multi-threaded environments)
DISABLE_PYMUPDF="true"


# ── Credits system ────────────────────────────────────────────────────────────
# Flat credits charged per successful workflow run (failed runs are never charged)
CREDITS_SOLUTION_COST="10"
CREDITS_SEARCH_COST="5"
# Credits granted automatically the first time a user's credit account is touched
CREDITS_INITIAL_BALANCE="100"
# false = pure tracking (runs never blocked, balance may go negative)
# true  = runs rejected with HTTP 402 when balance < workflow cost
CREDITS_ENFORCEMENT_ENABLED="false"
